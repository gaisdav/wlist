# Telegram Mini App env template.
# Copy to `apps/tma/.env` (or `.env.local`) and fill in the values.
# `.env*` files are gitignored except for this example.

# ---- Public (bundled into the browser) — keep them safe to expose ----

# Absolute URL where the Mini App is served. Used for share / deep-links.
# Local dev: http://localhost:5173
# Prod:      https://wlist-tma.vercel.app  (temporary; switch to https://wlist.pro once domain is live)
VITE_PUBLIC_APP_URL=http://localhost:5173

# Bot username (without the leading @), used to build native share links as
# `t.me/<bot>?startapp=<deep-link>`. When unset, sharing falls back to
# VITE_PUBLIC_APP_URL. Example: wlist_bot
VITE_PUBLIC_BOT_USERNAME=

# Supabase project URL — Settings → General in the Supabase Dashboard.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co

# Publishable key (Settings → API Keys → main tab, starts with `sb_publishable_…`).
# On legacy projects this is the JWT-based `anon` key (eyJ…) — both work.
# Safe to expose: RLS protects the data.
VITE_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
