# Repo-root env template — used by Supabase CLI and codegen scripts.
# Copy to `.env` and fill in. `.env*` files are gitignored.
# Browser-side env lives in `apps/tma/.env` (see apps/tma/.env.example).

# ---- Supabase CLI / codegen (local dev only — never bundled) ----

# Project Reference ID from Settings → General. Used by `pnpm db:link`.
SUPABASE_PROJECT_REF=

# Personal Access Token from https://supabase.com/dashboard/account/tokens
# Used by `supabase link`, `supabase db push`, `supabase gen types`.
SUPABASE_ACCESS_TOKEN=

# Optional — only needed if you connect directly via psql or run `supabase db
# push` from CI. Local dev usually doesn't need it (CLI prompts when required).
SUPABASE_DB_PASSWORD=
