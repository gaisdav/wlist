{
  "name": "wlist",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @wlist/tma dev",
    "build": "pnpm -r --parallel build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "validate": "pnpm lint:fix && pnpm format && pnpm typecheck && pnpm test",
    "prepare": "husky",
    "db:link": "supabase link --project-ref \"$SUPABASE_PROJECT_REF\"",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:push": "supabase db push",
    "db:diff": "supabase db diff -f",
    "db:types": "tmp=$(mktemp) && supabase gen types typescript --linked --schema public > \"$tmp\" && test -s \"$tmp\" && mv \"$tmp\" packages/api/src/generated/database.types.ts || { rm -f \"$tmp\"; echo 'db:types failed — database.types.ts left unchanged' >&2; exit 1; }",
    "db:zod": "supazod --input packages/api/src/generated/database.types.ts --output packages/api/src/generated/database.zod.ts --schema public",
    "db:codegen": "pnpm db:types && pnpm db:zod"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^25.0.0",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.0",
    "eslint-import-resolver-typescript": "^4.4.4",
    "eslint-plugin-import-x": "^4.16.2",
    "globals": "^17.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.0",
    "prettier": "^3.8.0",
    "supazod": "^4.5.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.59.0",
    "vitest": "^4.1.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ]
  }
}
